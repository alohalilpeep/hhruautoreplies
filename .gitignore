venv
__pycache__/
*.pyc
# Из .claude/ в гит идут только сабагенты. Остальное — воркты, настройки
# сессий и база фактов hh-facts.md с историями про работу — личное.
.claude/*
!.claude/agents/

# личные настройки: ID профиля, лимиты, URL поиска
.env

# история откликов, локальная база
hh_responses.db

# логи и состояние подъёма резюме
bump.log
bump_state.json
launchd.out.log
launchd.err.log

# сопроводительное письмо: личные контакты
letter.txt

# ответы на анкетные вопросы
answers.txt
knowledge.txt

# рабочий файл с ответами
answers_edit.txt
blacklist.txt
chat_answers_edit.txt
choices_edit.txt

# старые выгрузки и логи прогонов: не удаляем, но и в репозиторий не тащим
archive/
backups/
*.log
choices_today.txt
primer.txt
parked.json

# снимки живых тестов
tests/artifacts/

# личные данные: имя, контакты, дата рождения
profile.txt

# выгрузки вопросов: до агента (new/) и заполненные им (answered/)
questions/
