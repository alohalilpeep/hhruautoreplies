# Скопируй в .env и заполни своими значениями: cp .env.example .env

# BitBrowser Local API
BIT_API=http://127.0.0.1:54345
BIT_API_KEY=
# ID профиля BitBrowser, в котором залогинен hh.ru
PROFILE_ID=

# Настрой поиск на hh руками со всеми фильтрами и вставь URL из адресной строки.
# Полезные параметры:
#   text=DevOps OR SRE OR "системный администратор"   OR обязательно капсом,
#                                                     фразы из двух слов в кавычках
#   search_field=name          искать только в названии вакансии
#   experience=between3And6    noExperience | between1And3 | between3And6 | moreThan6
#   work_format=REMOTE         удалённая работа
#   area=113                   113 Россия, 1 Москва, 2 Санкт-Петербург
SEARCH_URL=

# Сколько страниц выдачи обходить, на странице 50 вакансий
MAX_PAGES=5
# Свой дневной лимит откликов
DAILY_LIMIT=50
# Часть названия резюме, если их несколько; пусто = резюме по умолчанию
RESUME_TITLE=

# True = только ходит и логирует, не откликается. Ставь False осознанно.
DRY_RUN=True

# False = откликаться без сопроводительного письма. Вакансии, где письмо
# обязательно, помечаются needs_letter и не трогаются до SEND_LETTER=True.
SEND_LETTER=False
